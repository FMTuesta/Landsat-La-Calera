var L9 = ee.ImageCollection('LANDSAT/LC09/C02/T1_L2');


// ------------------------------------------------------
// 4. PREPARAR LANDSAT
// ------------------------------------------------------

function prepararLandsat(image) {

  var qa = image.select('QA_PIXEL');

  // Excluir píxeles de relleno: bit 0
  var qaValido = qa.bitwiseAnd(1 << 0).eq(0)
    .rename('qa_valido');

  // Nubes: bits 1, 2 y 3
  var nube = qa.bitwiseAnd(1 << 1).neq(0)
    .or(qa.bitwiseAnd(1 << 2).neq(0))
    .or(qa.bitwiseAnd(1 << 3).neq(0))
    .rename('nube')
    .updateMask(qaValido);

  // Sombras de nubes: bit 4
  var sombra = qa.bitwiseAnd(1 << 4).neq(0)
    .rename('sombra')
    .updateMask(qaValido);

  // Nieve/hielo: bit 5
  var nieve = qa.bitwiseAnd(1 << 5).neq(0);

  // Máscara de temperatura:
  // excluir nubes, sombras, nieve/hielo y fill
  var mascaraTemperatura = nube.eq(0)
    .and(sombra.eq(0))
    .and(nieve.not())
    .and(qaValido);

  // Temperatura superficial en grados Celsius
  var temperatura = image.select('ST_B10')
    .multiply(0.00341802)
    .add(149.0)
    .subtract(273.15)
    .rename('temperatura_C')
    .updateMask(mascaraTemperatura);

  // Banda de conteo para píxeles con QA válido
  var qaConteo = ee.Image.constant(1)
    .rename('pixeles_QA_validos')
    .updateMask(qaValido);

  // Banda de conteo para píxeles con temperatura válida
  var tempConteo = ee.Image.constant(1)
    .rename('pixeles_temp_validos')
    .updateMask(temperatura.mask());

  return ee.Image.cat([
    temperatura,
    nube,
    sombra,
    qaConteo,
    tempConteo
  ]).copyProperties(image, image.propertyNames());
}


// ------------------------------------------------------
// 5. PREPARAR Y UNIR COLECCIONES
// ------------------------------------------------------

var coleccionL8 = L8
  .filterBounds(sectores)
  .filter(ee.Filter.lt('CLOUD_COVER', 20))
  .map(prepararLandsat);

var coleccionL9 = L9
  .filterBounds(sectores)
  .filter(ee.Filter.lt('CLOUD_COVER', 20))
  .map(prepararLandsat);

var Landsat = coleccionL8.merge(coleccionL9);

print('Colección Landsat:', Landsat);
print('Cantidad de imágenes:', Landsat.size());


// ------------------------------------------------------
// 6. MEDIA, DESVIACION ESTANDAR Y CONTEOS POR SECTOR
// ------------------------------------------------------

function datosPorSector(image, fechaMuestreo) {

  var bandas = image.select([
    'temperatura_C',
    'nube',
    'sombra',
    'pixeles_QA_validos',
    'pixeles_temp_validos'
  ]);

  // Calcular media, SD y conteo
  var reductor = ee.Reducer.mean()
    .combine({
      reducer2: ee.Reducer.stdDev(),
      sharedInputs: true
    })
    .combine({
      reducer2: ee.Reducer.count(),
      sharedInputs: true
    });

  var datos = bandas.reduceRegions({
    collection: sectores,
    reducer: reductor,
    scale: 30,
    tileScale: 4
  });

  var fechaImagen = image.date();

  return datos.map(function(feature) {

    var sector = feature.get('Sector');

    // Conteos de píxeles válidos
    var nQA = feature.get('pixeles_QA_validos_count');
    var nTemp = feature.get('temperatura_C_count');

    // Medias de las bandas binarias de nube y sombra
    var nubeMedia = feature.get('nube_mean');
    var sombraMedia = feature.get('sombra_mean');

    // Convertir proporciones a porcentajes
    var porcentajeNube = ee.Algorithms.If(
      ee.Algorithms.IsEqual(nubeMedia, null),
      null,
      ee.Number(nubeMedia).multiply(100)
    );

    var porcentajeSombra = ee.Algorithms.If(
      ee.Algorithms.IsEqual(sombraMedia, null),
      null,
      ee.Number(sombraMedia).multiply(100)
    );

    return feature.set({

      'Sector_fecha': ee.Algorithms.If(
        ee.Algorithms.IsEqual(sector, null),
        null,
        ee.String(sector).cat('_').cat(fechaMuestreo)
      ),

      'fecha_muestreo': fechaMuestreo,

      'fecha_imagen': fechaImagen.format('YYYY-MM-dd'),

      'diferencia_dias': fechaImagen.difference(
        ee.Date(fechaMuestreo), 'day'
      ),

      'hora_UTC': fechaImagen.format('HH:mm:ss'),

      'hora_local': fechaImagen
        .advance(-3, 'hour')
        .format('HH:mm:ss'),

      // Temperatura superficial promedio en °C
      'temperatura_media_C': feature.get('temperatura_C_mean'),

      // Desviación estándar de la temperatura en °C
      'temperatura_SD_C': feature.get('temperatura_C_stdDev'),

      // Porcentajes de nubes y sombras
      'porcentaje_nube_sector': porcentajeNube,
      'porcentaje_sombra_sector': porcentajeSombra,

      // Conteos de píxeles válidos
      'pixeles_QA_validos': nQA,
      'pixeles_temp_validos': nTemp,

      'ID_imagen': image.id()

    });
  });
}


// ------------------------------------------------------
// 7. BUSCAR IMAGENES EN VENTANA +/- 5 DIAS
// ------------------------------------------------------

function buscarFecha(fechaTexto) {

  var fecha = ee.Date(fechaTexto);
  var inicio = fecha.advance(-5, 'day');

  // Límite superior exclusivo: incluye fecha + 5 días
  var fin = fecha.advance(6, 'day');

  var coleccion = Landsat
    .filterDate(inicio, fin)
    .filterBounds(sectores);

  print(
    'Fecha de muestreo:',
    fechaTexto,
    'Cantidad de imágenes:',
    coleccion.size()
  );

  var procesadas = coleccion.map(function(image) {
    return datosPorSector(image, fechaTexto);
  }).flatten();

  return ee.FeatureCollection(procesadas);
}


// ------------------------------------------------------
// 8. PROCESAR TODAS LAS FECHAS
// ------------------------------------------------------

var resultados = ee.FeatureCollection([]);

fechas.forEach(function(fecha) {
  resultados = resultados.merge(buscarFecha(fecha));
});


// ------------------------------------------------------
// 9. ORDENAR Y MOSTRAR
