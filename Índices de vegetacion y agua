// ------------------------------------------------------
// 4. FUNCIÓN PARA PREPARAR LANDSAT
// ------------------------------------------------------

function prepararLandsat(image) {

  // -----------------------------------------------
  // QA_PIXEL
  // -----------------------------------------------

  var qa = image.select('QA_PIXEL');


  // Bit 3 = nube
  var nube = qa.bitwiseAnd(1 << 3)
    .neq(0)
    .rename('nube');


  // Bit 4 = sombra de nube
  var sombra = qa.bitwiseAnd(1 << 4)
    .neq(0)
    .rename('sombra');


  // -----------------------------------------------
  // MÁSCARA DE NUBES Y SOMBRAS
  // -----------------------------------------------

  var mascara = nube.not()
    .and(sombra.not());


  // -----------------------------------------------
  // BANDAS ÓPTICAS
  // -----------------------------------------------

  var opticalBands = image.select([
    'SR_B2',
    'SR_B3',
    'SR_B4',
    'SR_B5',
    'SR_B6'
  ])
  .multiply(0.0000275)
  .add(-0.2);


  // Aplicar máscara a las bandas ópticas

  opticalBands = opticalBands.updateMask(
    mascara
  );


  // -----------------------------------------------
  // NDVI
  // -----------------------------------------------

  var NDVI = opticalBands
    .normalizedDifference([
      'SR_B5',
      'SR_B4'
    ])
    .rename('NDVI');


  // -----------------------------------------------
  // SAVI
  // -----------------------------------------------

  var L = 0.5;

  var SAVI = opticalBands.expression(
    '((NIR - RED) / (NIR + RED + L)) * (1 + L)',
    {
      NIR: opticalBands.select('SR_B5'),
      RED: opticalBands.select('SR_B4'),
      L: L
    }
  ).rename('SAVI');


  // -----------------------------------------------
  // EVI
  // -----------------------------------------------

  var EVI = opticalBands.expression(
    '2.5 * ((NIR - RED) / ' +
    '(NIR + 6 * RED - 7.5 * BLUE + 1))',
    {
      NIR: opticalBands.select('SR_B5'),
      RED: opticalBands.select('SR_B4'),
      BLUE: opticalBands.select('SR_B2')
    }
  ).rename('EVI');


  // -----------------------------------------------
  // MNDWI
  // -----------------------------------------------

  var MNDWI = opticalBands
    .normalizedDifference([
      'SR_B3',
      'SR_B6'
    ])
    .rename('MNDWI');


  // -----------------------------------------------
  // DEVOLVER BANDAS
  // -----------------------------------------------

  return ee.Image.cat([
    NDVI,
    SAVI,
    EVI,
    MNDWI,
    nube,
    sombra
  ]).copyProperties(
    image,
    image.propertyNames()
  );

}


// ------------------------------------------------------
// 5. PREPARAR COLECCIONES
// ------------------------------------------------------

var coleccionL8 = L8
  .filterBounds(sectores)
  .filter(ee.Filter.lt('CLOUD_COVER', 20))
  .map(prepararLandsat);


var coleccionL9 = L9
  .filterBounds(sectores)
  .filter(ee.Filter.lt('CLOUD_COVER', 20))
  .map(prepararLandsat);


// Unir Landsat 8 + Landsat 9

