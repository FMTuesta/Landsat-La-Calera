// ------------------------------------------------------
// 6. FUNCIÓN: ÍNDICES POR SECTOR
// ------------------------------------------------------

function datosPorSector(
  image,
  fechaMuestreo
) {


  // -----------------------------------------------
  // BANDAS A EXTRAER
  // -----------------------------------------------

  var imagenExtraccion = image.select([
    'NDVI',
    'SAVI',
    'EVI',
    'MNDWI',
    'nube',
    'sombra'
  ]);


  // -----------------------------------------------
  // PROMEDIO DE CADA VARIABLE POR SECTOR
  // -----------------------------------------------

  var datos = imagenExtraccion.reduceRegions({

    collection: sectores,

    reducer: ee.Reducer.mean(),

    // Landsat = 30 m

    scale: 30

  });


  // -----------------------------------------------
  // AGREGAR INFORMACIÓN DE LA IMAGEN
  // -----------------------------------------------

  return datos.map(function(feature) {

    var fechaImagen = image.date();


    // ---------------------------------------------
    // IDENTIFICADOR DEL SECTOR
    // ---------------------------------------------

    var sector = feature.get('Sector');


    // ---------------------------------------------
    // PORCENTAJES DE NUBE Y SOMBRA
    // ---------------------------------------------

    var porcentajeNube = ee.Number(
      feature.get('nube')
    ).multiply(100);


    var porcentajeSombra = ee.Number(
      feature.get('sombra')
    ).multiply(100);


    // ---------------------------------------------
    // RESULTADO FINAL
    // ---------------------------------------------

    return feature.set({

      'Sector': sector,

      'Sector_fecha': ee.Algorithms.If(
        sector,
        ee.String(sector)
          .cat('_')
          .cat(fechaMuestreo),
        null
      ),

      'fecha_muestreo': fechaMuestreo,

      'fecha_imagen': fechaImagen.format(
        'YYYY-MM-dd'
      ),

      'diferencia_dias': fechaImagen.difference(
        ee.Date(fechaMuestreo),
        'day'
      ),

      'hora_UTC': fechaImagen.format(
        'HH:mm:ss'
      ),

      'hora_local': fechaImagen
        .advance(-3, 'hour')
        .format('HH:mm:ss'),

      'porcentaje_nube_sector':
        porcentajeNube,

      'porcentaje_sombra_sector':
        porcentajeSombra,

      'ID_imagen':
        image.id()

    });

  });

}


// ------------------------------------------------------
// 7. BUSCAR IMÁGENES +/- 5 DÍAS
// ------------------------------------------------------

function buscarFecha(fechaTexto) {

  var fecha = ee.Date(fechaTexto);

  var inicio = fecha.advance(
    -5,
    'day'
  );

  // +6 porque filterDate tiene
  // límite superior exclusivo

  var fin = fecha.advance(
    6,
    'day'
  );


  var coleccion = Landsat
    .filterDate(inicio, fin)
    .filterBounds(sectores);


  print(
    'Fecha de muestreo:',
    fechaTexto,
    'Cantidad de imágenes:',
    coleccion.size()
  );


  // -----------------------------------------------
  // PROCESAR CADA IMAGEN
  // -----------------------------------------------

  return coleccion.map(function(image) {

    return datosPorSector(
      image,
      fechaTexto
    );

  }).flatten();

}


// ------------------------------------------------------
// 8. APLICAR A TODAS LAS FECHAS
// ------------------------------------------------------

var resultados = ee.FeatureCollection(
  fechas.map(buscarFecha)
